rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reviews collection: Open read for community critique feed & average score calculations
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // User profile documents and subcollections (wishlist, custom lists, dossier pins)
    match /users/{userId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Top-level wishlists & user lists
    match /wishlists/{wishlistId} {
      allow read, write: if true;
    }

    match /user_lists/{listId} {
      allow read, write: if true;
    }
  }
}
